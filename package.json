{
  "name": "the-last-lantern",
  "version": "0.4.1-gate-c-followup",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "node scripts/browser-tests.mjs",
    "assets": "blender -b -t 4 --python scripts/render-assets.py -- --only all --samples 48 && blender -b -t 4 --python scripts/render-campaign-assets.py -- --samples 48 && python3 scripts/pack-3d-assets.py",
    "package:playtest": "npm run build && python3 scripts/package-playtest.py",
    "measure": "node scripts/measure.mjs",
    "assets:campaign": "blender -b -t 4 --python scripts/render-campaign-assets.py -- --samples 48 && python3 scripts/pack-3d-assets.py",
    "measure:gate-c": "node scripts/benchmark-gate-c.mjs",
    "measure:gate-c:paired": "node scripts/paired-benchmark-gate-c.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.2.8",
    "@fontsource-variable/fraunces": "5.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.0",
    "playwright-core": "1.58.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
