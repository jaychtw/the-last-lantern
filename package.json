{
  "name": "the-last-lantern",
  "version": "0.1.0-gate-a",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "node scripts/browser-tests.mjs",
    "assets": "python3 scripts/create-assets.py",
    "package:playtest": "npm run build && python3 scripts/package-playtest.py",
    "measure": "node scripts/measure.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.2.8",
    "@fontsource-variable/fraunces": "5.2.8",
    "pixi.js": "8.14.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.0",
    "playwright-core": "1.58.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.4"
  }
}
