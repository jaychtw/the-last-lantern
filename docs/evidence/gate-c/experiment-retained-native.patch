+/* Retained Canvas2D scenery: exact world positions/depth, browser-cached pixels.
+   The separate transparent effects plane keeps particles/light/fades animated. */
+#world .world-scenery{position:absolute;left:0;top:0;pointer-events:none;transform-origin:0 0;will-change:transform}
+#world .world-scenery canvas{position:absolute;left:0;top:0;pointer-events:none}
+#world .world-scenery canvas[hidden]{display:none}
+#world .world-effects{position:absolute;inset:0;pointer-events:none}
